{
  "name": "@unblocklabs/gog-email-watch",
  "version": "0.3.10",
  "license": "MIT",
  "description": "Label-first Gmail triage, configurable mailbox routing and approved-sender agent workflows through gog.",
  "type": "module",
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "openclaw": {
    "install": {
      "npmSpec": "@unblocklabs/gog-email-watch",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.9.9"
    },
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.9"
    },
    "build": {
      "openclawVersion": "2026.9.9",
      "pluginSdkVersion": "2026.9.9"
    },
    "release": {
      "publishToNpm": true,
      "publishToClawHub": false
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/sync-manifest.mjs --check",
    "manifest:sync": "tsc -p tsconfig.build.json && node scripts/sync-manifest.mjs",
    "prepack": "npm run build",
    "release:check": "node scripts/check-release-version.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "plugin:inspect": "plugin-inspector check --config plugin-inspector.config.json --no-openclaw",
    "plugin:inspect:runtime": "plugin-inspector capture dist/index.js --real-sdk --allow-execute --plugin-root . --output reports/runtime-capture.json",
    "preflight": "npm run check && npm run build && npm test && npm run plugin:inspect && npm run plugin:inspect:runtime && npm pack --dry-run --ignore-scripts"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41",
    "email-addresses": "^5.0.0",
    "tiktoken": "^1.0.22"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.9"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openclaw/plugin-inspector": "0.3.26",
    "@types/node": "^22.19.0",
    "ajv": "^8.20.0",
    "openclaw": "2026.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unblocklabs-ai/gog-email-watch.git"
  },
  "homepage": "https://github.com/unblocklabs-ai/gog-email-watch#readme",
  "bugs": {
    "url": "https://github.com/unblocklabs-ai/gog-email-watch/issues"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.32.0"
  }
}
